# Copy to .env and adjust (run.bat does the copy on first start). Real environment variables win.

# --- LLM (text-to-text only; documents are parsed locally) --------------------
# Every option runs under the same 10K-token-per-call limit (MAX_CONTEXT_TOKENS), enforced by DocChat
# even when the model itself allows more. Measured results: evaluation/results/RESULTS_INDEX.md.
#
# Option A (default): open-weights Qwen 3.8 27B served by Groq's OpenAI-compatible API.
#   Get a free key at https://console.groq.com/keys and paste it below.
#   Measured: Q1-Q3 answered completely; 26/27 dev answers; resisted 9/9 instructions planted in documents.
#   Free tier: ~7,000 input tokens/minute (DocChat waits instead of failing) and 200,000 tokens/day.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_INPUT_TPM=7000

# Option B (offline, no key): open-weights qwen2.5:14b on Ollama; nothing leaves the machine.
#   Needs a GPU with ~10 GB VRAM for usable speed (or Option C). Measured: Q1 3/3 and Q2 2/3, but Q3
#   (the ablation table) was incomplete in 3/3 runs, and it is more easily steered by instructions
#   planted in documents. Use Option A for the three core test questions.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:14b
# LLM_INPUT_TPM=0

# Option C: the same qwen2.5:14b on a free Colab GPU (colab/docchat_gpu_backend.ipynb prints these
# lines; also set the Option B lines above).
# LLM_BASE_URL=https://xxxx.trycloudflare.com
# EMBED_BASE_URL=https://xxxx.trycloudflare.com

# --- Retrieval (always local) ----------------------------------------------------
# Embeddings via a local Ollama (`ollama pull nomic-embed-text`, ~274 MB); "none" = keyword BM25 only.
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Local cross-encoder reranker (FastEmbed, CPU); "none" disables the second stage
RERANK_MODEL=BAAI/bge-reranker-base

# --- Limits (the design assumes a 10K-token LLM context) ---------------------
MAX_CONTEXT_TOKENS=10000
# Model's own context window if smaller (0 = ask Ollama). Effective = min(both).
MODEL_CONTEXT_TOKENS=0
ANSWER_MAX_TOKENS=1800
RETRIEVAL_TOKEN_BUDGET=5500

# Build the whole-document summary notes right after upload. Default false: they are built on the
# first summary request and cached, so documents nobody summarises cost no LLM calls.
SUMMARY_ON_UPLOAD=false
